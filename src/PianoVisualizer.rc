#include <windows.h>
#include "resource.h"

IDI_PIANOVISUALIZER ICON "PianoVisualizer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Pirozhki\0"
            VALUE "FileDescription", "Piano Visualizer Classic\0"
            VALUE "FileVersion", "1.2.0\0"
            VALUE "InternalName", "PianoVisualizerClassic\0"
            VALUE "OriginalFilename", "PianoVisualizerClassic.exe\0"
            VALUE "ProductName", "Piano Visualizer Classic\0"
            VALUE "ProductVersion", "1.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_CONTROL_DIALOG DIALOGEX 0, 0, 430, 532
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_TOOLWINDOW
CAPTION "Piano Visualizer Classic Control"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "MIDI File", -1,                         12, 10, 55, 12
    LTEXT           "(No MIDI loaded)", IDC_LABEL_FILE,      70, 10, 340, 12, SS_LEFTNOWORDWRAP

    PUSHBUTTON      "Open MIDI...", IDC_BTN_OPEN,            12, 30, 86, 24
    PUSHBUTTON      "Play", IDC_BTN_PLAY,                    104, 30, 52, 24
    PUSHBUTTON      "Restart", IDC_BTN_RESTART,              162, 30, 60, 24
    PUSHBUTTON      "Render Video...", IDC_BTN_RENDER,       232, 30, 94, 24

    LTEXT           "Status", -1,                           12, 64, 40, 12
    LTEXT           "No MIDI", IDC_LABEL_STATUS,             58, 64, 320, 12, SS_LEFTNOWORDWRAP

    LTEXT           "Position", -1,                         12, 84, 52, 12
    CONTROL         "", IDC_POSITION_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 68, 78, 250, 24
    LTEXT           "0:00 / 0:00", IDC_LABEL_TIME,           324, 84, 78, 12, SS_RIGHT | SS_LEFTNOWORDWRAP

    LTEXT           "Fall speed", -1,                       12, 113, 55, 12
    CONTROL         "", IDC_SPEED_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 70, 108, 248, 24
    LTEXT           "380 px/s", IDC_LABEL_SPEED,             324, 113, 78, 12, SS_RIGHT

    LTEXT           "Background", -1,                       12, 141, 62, 12
    PUSHBUTTON      "Image...", IDC_BTN_BACKGROUND_IMAGE,             78, 136, 66, 22
    PUSHBUTTON      "Video...", IDC_BTN_BACKGROUND_VIDEO,       148, 136, 66, 22
    PUSHBUTTON      "Default BG", IDC_BTN_BACKGROUND_RESET,     218, 136, 70, 22
    LTEXT           "(No background)", IDC_LABEL_BACKGROUND,     294, 141, 116, 12, SS_LEFTNOWORDWRAP

    LTEXT           "Opacity", -1,                          12, 168, 46, 12
    CONTROL         "", IDC_BG_OPACITY_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 60, 162, 258, 24
    LTEXT           "30%", IDC_LABEL_BG_OPACITY,             324, 168, 78, 12, SS_RIGHT

    LTEXT           "Video offset", -1,                       12, 196, 64, 12
    CONTROL         "", IDC_VIDEO_OFFSET_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 80, 190, 238, 24
    LTEXT           "+0 ms", IDC_LABEL_VIDEO_OFFSET,            324, 196, 78, 12, SS_RIGHT

    LTEXT           "Effect", -1,                           12, 226, 46, 12
    AUTOCHECKBOX    "Smoke Glow", IDC_EFFECT_SMOKE,            60, 238, 90, 16, WS_TABSTOP
    AUTOCHECKBOX    "Spark", IDC_EFFECT_SPARK,                 60, 256, 78, 16, WS_TABSTOP
    AUTOCHECKBOX    "Note Glow", IDC_EFFECT_NOTE_GLOW,         60, 274, 90, 16, WS_TABSTOP
    AUTOCHECKBOX    "Smoke Window", IDC_EFFECT_SMOKE_WINDOW,    60, 292, 105, 16, WS_TABSTOP
    AUTOCHECKBOX    "White Particles", IDC_EFFECT_AMBIENT_PARTICLES, 60, 310, 104, 16, WS_TABSTOP

    AUTOCHECKBOX    "Ripple", IDC_EFFECT_RIPPLE,               170, 238, 78, 16, WS_TABSTOP
    AUTOCHECKBOX    "Diamond Ripple", IDC_EFFECT_DIAMOND_RIPPLE, 170, 256, 110, 16, WS_TABSTOP
    AUTOCHECKBOX    "Light Cross", IDC_EFFECT_CROSS_SPARK,    170, 274, 90, 16, WS_TABSTOP
    AUTOCHECKBOX    "Wave Line", IDC_EFFECT_WAVE_LINE,          170, 292, 90, 16, WS_TABSTOP
    PUSHBUTTON      "Line Color...", IDC_BTN_WAVE_COLOR,       276, 289, 96, 22
    AUTOCHECKBOX    "Impact Polygons", IDC_EFFECT_IMPACT_POLYGONS, 170, 310, 102, 16, WS_TABSTOP
    AUTOCHECKBOX    "Octave Guide Lines", IDC_NOTE_GUIDES,      276, 310, 135, 16, WS_TABSTOP

    LTEXT           "White particle count", -1,                  12, 333, 95, 12
    CONTROL         "", IDC_AMBIENT_PARTICLES_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 108, 326, 210, 24
    LTEXT           "40", IDC_LABEL_AMBIENT_PARTICLES,         324, 333, 78, 12, SS_RIGHT

    LTEXT           "Track color", -1,                       12, 372, 62, 12
    CONTROL         "", IDC_TRACK_COMBO, "COMBOBOX", CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, 78, 367, 190, 76
    PUSHBUTTON      "Choose Color...", IDC_BTN_TRACK_COLOR,  276, 366, 96, 22
    PUSHBUTTON      "Reset All", IDC_BTN_TRACK_RESET,       276, 393, 96, 22
    LTEXT           "Track palette", IDC_LABEL_TRACK_COLOR,  78, 397, 190, 12, SS_LEFTNOWORDWRAP

    LTEXT           "Audio", -1,                            12, 427, 42, 12
    AUTOCHECKBOX    "Enable sound during playback", IDC_ENABLE_AUDIO, 60, 424, 190, 18, WS_TABSTOP
    LTEXT           "Volume", -1,                           12, 453, 44, 12
    CONTROL         "", IDC_VOLUME_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 60, 447, 258, 24
    LTEXT           "75%", IDC_LABEL_VOLUME,                 324, 453, 78, 12, SS_RIGHT
    LTEXT           "Internal simple piano synth (XAudio2)", IDC_LABEL_AUDIO_STATUS, 60, 476, 330, 12, SS_LEFTNOWORDWRAP

    LTEXT           "Rendering creates H.264/AAC MP4 via FFmpeg.", -1, 12, 503, 390, 12, SS_LEFT
END

IDD_RENDER_DIALOG DIALOGEX 0, 0, 390, 255
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_TOOLWINDOW
CAPTION "Render Video"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Width", -1,                 14, 16, 50, 12
    EDITTEXT        IDC_RENDER_WIDTH,             72, 12, 90, 20, ES_NUMBER | WS_TABSTOP
    LTEXT           "Height", -1,                180, 16, 50, 12
    EDITTEXT        IDC_RENDER_HEIGHT,            238, 12, 90, 20, ES_NUMBER | WS_TABSTOP

    LTEXT           "Frame rate", -1,             14, 44, 60, 12
    LTEXT           "60 fps", -1,                 72, 44, 90, 12

    LTEXT           "Output", -1,                 14, 70, 50, 12
    EDITTEXT        IDC_RENDER_OUTPUT,            72, 66, 242, 20, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_RENDER_BROWSE, 320, 64, 56, 24

    AUTOCHECKBOX    "Include audio", IDC_RENDER_AUDIO, 14, 99, 110, 18, WS_TABSTOP
    LTEXT           "Audio volume", -1,           145, 102, 72, 12
    LTEXT           "75%", IDC_RENDER_AUDIO_VOLUME, 222, 102, 55, 12, SS_RIGHT

    CONTROL         "", IDC_RENDER_PROGRESS, "msctls_progress32", PBS_SMOOTH, 14, 135, 362, 20
    LTEXT           "Ready", IDC_RENDER_STATUS, 14, 164, 362, 30, SS_LEFT

    PUSHBUTTON      "Render", IDC_RENDER_RENDER, 220, 212, 74, 26, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDC_RENDER_CANCEL, 302, 212, 74, 26, WS_TABSTOP
END

IDD_RENDER_CANCEL_DIALOG DIALOGEX 0, 0, 340, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_TOOLWINDOW
CAPTION "Rendering Video"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Rendering video...", -1,                         14, 14, 312, 14
    CONTROL         "", IDC_RENDER_CANCEL_PROGRESS, "msctls_progress32", PBS_SMOOTH, 14, 38, 312, 20
    LTEXT           "Preparing...", IDC_RENDER_CANCEL_STATUS,         14, 64, 312, 18, SS_LEFT
    PUSHBUTTON      "Cancel Rendering", IDC_RENDER_ABORT,             238, 94, 88, 24, WS_TABSTOP
END
